// Artemis - schéma de données (canonique).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  REPORTER
}

enum SprintState {
  PLANNED
  ACTIVE
  COMPLETED
}

enum EmailStatus {
  SENT
  FAILED
  DISABLED
}

// Cycle de validation d'une brique de structure (module, composant) proposée par
// un rapporteur. Un ADMIN crée directement en APPROVED ; un rapporteur soumet en
// PROPOSED. Tant qu'une proposition n'est pas validée, elle n'apparaît NI dans les
// sélecteurs de ticket, NI dans le contexte transmis à l'IA, NI via MCP : la
// validation est ce qui la fait exister pour le reste de l'application.
// Refuser une proposition la supprime : n'étant référencée par aucun ticket, il
// n'y a pas d'orphelin à gérer, et l'on évite un cimetière d'entrées rejetées.
enum ProposalStatus {
  PROPOSED
  APPROVED
}

// Modèle de ticket imposé par un type (cf. model TicketType) : quelles rubriques
// la description doit obligatoirement comporter.
//   NONE   - description libre, aucune contrainte (comportement historique) ;
//   REPORT - rapport structuré : Observation, Attendu et Contexte sont exigés,
//            « Alignement aux spécifications » reste facultatif.
// Le modèle est porté par le TYPE, pas par le projet : « Bug » mérite un rapport
// complet, « Tâche » non. Par défaut NONE, si bien qu'activer la fonctionnalité
// est un geste d'administrateur et qu'aucun projet existant ne change de
// comportement à la migration.
enum TicketTemplate {
  NONE
  REPORT
}

// Section prédéfinie du wiki (cf. model WikiSection). Trois rapports au temps,
// et non trois dossiers - c'est ce qui justifie de les prédéfinir :
//   SPEC           - temps VERSIONNÉ : des états publiés, figés, citables à jamais ;
//   MEETING        - temps PONCTUEL : une page clouée à une date, jamais réécrite ;
//   IMPLEMENTATION - temps CONTINU : toujours l'état actuel du système.
enum WikiSectionKind {
  SPEC
  MEETING
  IMPLEMENTATION
}

// Nature d'un composant applicatif (cf. model Component).
//   PAGE    - un écran / une route de l'application ;
//   SHARED  - un composant réutilisable (design system, widget partagé) ;
//   SERVICE - un service technique (API, job, intégration externe).
enum ComponentKind {
  PAGE
  SHARED
  SERVICE
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String?
  passwordHash       String?
  role               Role                @default(REPORTER)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  reported           Ticket[]            @relation("reporter")
  assigned           Ticket[]            @relation("assignee")
  comments           Comment[]
  attachments        Attachment[]
  wikiPages          WikiPage[]
  memberships        ProjectMember[]
  setupToken         PasswordSetupToken?
  proposedModules    Module[]            @relation("moduleProposals")
  proposedComponents Component[]         @relation("componentProposals")
  wikiRevisions      WikiRevision[]
  specVersions       SpecVersion[]
}

// Jeton de premiere connexion / reinitialisation : lien a usage unique et date
// permettant a un utilisateur de definir son mot de passe. Un seul jeton actif
// par utilisateur (regenerer remplace le precedent). Seul le hash est stocke.
model PasswordSetupToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Journal des e-mails : suivi de tous les envois (notifications, invitations,
// reinitialisation). Statut DISABLED = envoi ignore car Mailjet non configure.
model EmailLog {
  id        String      @id @default(cuid())
  to        String
  subject   String
  type      String // "comment" | "assignment" | "invite" | "reset"
  status    EmailStatus
  error     String?
  createdAt DateTime    @default(now())

  @@index([createdAt])
}

model Project {
  id               String           @id @default(cuid())
  key              String           @unique // ex : "RKN"
  name             String
  description      String?
  accentColor      String? // couleur d'accent personnalisée (hex), null = charte par défaut
  ticketSeq        Int              @default(0) // séquence pour générer les clés RKN-<n>
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  columns          Column[]
  tickets          Ticket[]
  sprints          Sprint[]
  labels           Label[]
  ticketTypes      TicketType[]
  ticketPriorities TicketPriority[]
  modules          Module[]
  components       Component[]
  wikiPages        WikiPage[]
  specPackages     SpecPackage[]
  wikiPageSlugs    WikiPageSlug[]
  wikiSections     WikiSection[]
  members          ProjectMember[]
}

// Appartenance d'un utilisateur à un projet : contrôle l'accès.
// Les administrateurs accèdent à tous les projets sans ligne ici ; cette table
// n'accorde l'accès qu'aux Rapporteurs projet par projet.
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}

model Column {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  order     Int
  wipLimit  Int?
  tickets   Ticket[]

  @@index([projectId])
}

// Type de ticket - configurable par projet.
model TicketType {
  id        String         @id @default(cuid())
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  color     String // hex, ex : "#6366F1"
  order     Int
  // Rubriques imposées à la description des tickets de ce type (cf. enum).
  template  TicketTemplate @default(NONE)
  tickets   Ticket[]

  @@unique([projectId, name])
  @@index([projectId])
}

// Priorité de ticket - configurable par projet.
model TicketPriority {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  color     String // hex
  order     Int
  tickets   Ticket[]

  @@unique([projectId, name])
  @@index([projectId])
}

// Module fonctionnel d'un projet : un ensemble de fonctionnalités à grosse
// maille (ex. « Gestion des utilisateurs »), au-dessus des composants. C'est de
// la STRUCTURE PRODUIT, pas un conteneur de travail : un module ne se « termine »
// pas, contrairement à un sprint ou un lot. Il regroupe plusieurs composants
// (écrans, briques partagées, services) et sert à situer une demande à maille
// large. Entièrement facultatif : un projet peut n'en déclarer aucun.
model Module {
  id           String         @id @default(cuid())
  projectId    String
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  description  String? // contexte libre (périmètre fonctionnel du module)
  color        String // hex, ex : "#0EA5E9"
  order        Int
  // Validation : APPROVED par défaut (création par un admin, et données existantes).
  status       ProposalStatus @default(APPROVED)
  // Auteur de la proposition, pour que l'admin sache qui la demande. `SetNull` :
  // la suppression d'un compte ne doit pas emporter la brique de structure.
  proposedById String?
  proposedBy   User?          @relation("moduleProposals", fields: [proposedById], references: [id], onDelete: SetNull)
  components   Component[]
  tickets      Ticket[]
  // Pages du wiki qui documentent ce module.
  wikiPages    WikiPageModule[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
  @@index([projectId, status])
}

// Composant applicatif d'un projet : la brique fonctionnelle CONCERNÉE par une
// demande (« de quoi parle ce ticket ? »). Configurable par projet, comme les
// types et priorités, avec en plus une NATURE (`kind`) : page, composant
// réutilisable ou service. La `description` porte le contexte métier/technique
// du composant : elle est affichée dans l'UI et injectée dans le contexte
// transmis à l'IA lors de la génération de tickets.
model Component {
  id           String         @id @default(cuid())
  projectId    String
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Module de rattachement (facultatif). Les composants transverses - typiquement
  // les `SHARED`, qui servent plusieurs modules - n'en ont volontairement aucun.
  moduleId     String?
  module       Module?        @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  name         String
  kind         ComponentKind  @default(PAGE)
  description  String? // contexte libre (rôle, périmètre, contraintes)
  color        String // hex, ex : "#8B5CF6"
  order        Int
  // Validation : voir `ProposalStatus`. Même logique que pour un module.
  status       ProposalStatus @default(APPROVED)
  proposedById String?
  proposedBy   User?          @relation("componentProposals", fields: [proposedById], references: [id], onDelete: SetNull)
  tickets      Ticket[]
  // Pages du wiki qui documentent ce composant.
  wikiPages    WikiPageComponent[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
  @@index([moduleId])
  @@index([projectId, status])
}

model Ticket {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number      Int // numéro séquentiel par projet
  key         String // "RKN-123" (dénormalisé pour affichage / recherche)
  title       String
  description String?
  typeId      String
  type        TicketType      @relation(fields: [typeId], references: [id])
  priorityId  String
  priority    TicketPriority  @relation(fields: [priorityId], references: [id])
  // Composant concerné (facultatif) : contextualise la demande. `SetNull` pour
  // qu'un composant supprimé n'entraîne jamais la perte d'un ticket.
  componentId String?
  component   Component?      @relation(fields: [componentId], references: [id], onDelete: SetNull)
  // Module PROPRE du ticket, renseignable uniquement lorsqu'aucun composant n'est
  // choisi (demande à grosse maille). INVARIANT imposé par le service : dès qu'un
  // composant est posé, ce champ repasse à `null` et le module effectif du ticket
  // devient celui du composant. Une seule source de vérité, donc jamais de
  // contradiction entre le module du ticket et celui de son composant.
  moduleId    String?
  module      Module?         @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  columnId    String
  column      Column          @relation(fields: [columnId], references: [id])
  rank        String // ordre dans la colonne (lexorank)
  reporterId  String
  reporter    User            @relation("reporter", fields: [reporterId], references: [id])
  assigneeId  String?
  assignee    User?           @relation("assignee", fields: [assigneeId], references: [id])
  sprintId    String?
  sprint      Sprint?         @relation(fields: [sprintId], references: [id])
  labels      LabelOnTicket[]
  attachments Attachment[]
  comments    Comment[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([projectId, number])
  @@index([projectId, columnId])
  @@index([sprintId])
  @@index([typeId])
  @@index([priorityId])
  @@index([componentId])
  @@index([moduleId])
}

model Sprint {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  goal      String?
  state     SprintState @default(PLANNED)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime    @default(now())
  tickets   Ticket[]

  @@index([projectId])
}

model Label {
  id        String          @id @default(cuid())
  projectId String
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  color     String // hex, ex : "#7C3AED"
  tickets   LabelOnTicket[]

  @@unique([projectId, name])
}

model LabelOnTicket {
  ticketId String
  labelId  String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  label    Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([ticketId, labelId])
}

model Attachment {
  id           String   @id @default(cuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  filename     String
  contentType  String
  size         Int
  storageKey   String
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([ticketId])
}

model Comment {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([ticketId])
}

// Page de wiki d'un projet - documentation libre, avec citations de tickets (RKN-123).
// Organisation arborescente : une page peut avoir une page parente (self-relation).
model WikiPage {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    WikiPage?  @relation("WikiTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  WikiPage[] @relation("WikiTree")
  title     String
  content   String     @default("")
  authorId  String?
  author    User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Date de la réunion dont cette page est le compte rendu. Non nulle = la page
  // EST un compte rendu : un seul champ sert donc de marqueur et porte
  // l'information dont le suivi a besoin pour trier. La structure du compte
  // rendu (thèmes, items) vit dans le Markdown et n'est pas stockée : un thème
  // n'existe que le temps d'une réunion (cf. `@/lib/meeting-minutes`).
  meetingDate DateTime?

  // Identifiant lisible pour l'URL (« guide-du-projet »). L'identité reste
  // portée par `id` : le slug n'est qu'une clef d'accès commode, faite pour
  // qu'une adresse se lise et se mette en favori.
  //
  // NULLABLE à dessein : les pages antérieures à la fonctionnalité n'en ont pas
  // encore, et l'affectation se fait par le script de reprise (ou au premier
  // enregistrement). Générer les slugs en SQL dans la migration aurait supposé
  // réécrire l'algorithme une seconde fois, en PL/pgSQL, où il aurait
  // immanquablement divergé de celui qui est testé.
  slug        String?
  slugAliases WikiPageSlug[]

  // Titre et contenu REPLIÉS pour la recherche : sans accents, en minuscules
  // (cf. `@/lib/search-text`). C'est cette colonne qu'indexe le GIN plein texte,
  // et non `content` : la configuration `french` de PostgreSQL ne replie pas les
  // accents de façon fiable, et l'extension `unaccent` aurait imposé un
  // `CREATE EXTENSION` sur chaque base.
  //
  // NULLABLE comme `slug`, et pour la même raison : les pages antérieures sont
  // reprises par script (`npm run db:backfill-wiki`), non par du SQL qui
  // dupliquerait un algorithme déjà testé.
  searchText  String?

  // Date de la dernière RELECTURE déclarée : « j'ai relu, c'est toujours vrai ».
  //
  // Distincte d'`updatedAt`, et c'est tout l'intérêt : une page qui reste juste
  // ne se modifie pas, et n'aurait donc jamais l'air fraîche si l'on ne jugeait
  // que par sa dernière écriture. La fraîcheur retient la plus récente des deux
  // (cf. `@/lib/wiki-freshness`) - modifier une page, c'est aussi la relire.
  //
  // Ne concerne en pratique que la section IMPLÉMENTATION : une spécification
  // vit en versions figées, un compte rendu est daté et ne vieillit pas. Seule
  // la documentation technique a pour mode de défaillance de devenir fausse
  // sans que rien ne le signale.
  reviewedAt  DateTime?

  revisions   WikiRevision[]
  // Renseigne uniquement si CETTE page est la racine d'un paquet de spécifications.
  specPackage SpecPackage?
  // Sujets documentés par cette page : modules et composants du catalogue.
  modules     WikiPageModule[]
  components  WikiPageComponent[]
  // Renseigne uniquement si CETTE page est la racine d'une section prédéfinie.
  // L'appartenance des AUTRES pages ne se stocke pas : elle se calcule en
  // remontant les ancêtres (cf. `@/lib/wiki-tree`).
  wikiSection WikiSection?
  snapshots   SpecPageSnapshot[]

  @@unique([projectId, slug])
  @@index([projectId])
  @@index([parentId])
}

// ANCIEN slug d'une page, conservé après un renommage.
//
// Sans cette table, corriger une coquille dans un titre casserait tous les
// favoris et tous les liens déjà partagés vers la page - exactement ce que la
// fonctionnalité cherche à éviter. Avec elle, l'adresse suit toujours le titre
// courant et les anciennes continuent d'y mener.
//
// `projectId` est dénormalisé pour porter l'unicité : deux projets peuvent avoir
// eu chacun une page « guide-du-projet ».
model WikiPageSlug {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pageId    String
  page      WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  slug      String
  createdAt DateTime @default(now())

  @@unique([projectId, slug])
  @@index([pageId])
}

// Révision d'une page de wiki : l'état du titre et du contenu APRÈS chaque
// enregistrement. Une révision est écrite à la création de la page puis à chaque
// modification, si bien que la plus récente reflète toujours la page courante.
//
// Le choix d'archiver l'état APRÈS (et non avant) coûte une ligne dupliquée mais
// rend l'historique uniforme : « voir la révision du 12 mars » se lit toujours de
// la même façon, et l'on sait enfin QUI a modifié en dernier - `WikiPage.authorId`
// ne désigne que le créateur, jamais l'éditeur suivant.
model WikiRevision {
  id        String   @id @default(cuid())
  pageId    String
  page      WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title     String
  content   String
  // Auteur de la modification. `SetNull` : la révision survit à la suppression
  // du compte, un historique amputé ne serait plus un historique.
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([pageId, createdAt])
}

// PAQUET DE SPÉCIFICATIONS : un sous-arbre du wiki traité comme un document
// unique et versionnable. Le paquet est ancré sur UNE page racine ; celle-ci et
// toutes ses descendantes en font partie.
//
// L'ancrage sur un sous-arbre plutôt qu'une appartenance page par page est
// délibéré : une spécification est un document, et un chapitre ne peut pas en
// sortir sans sortir aussi ses sous-chapitres. L'arborescence du wiki porte donc
// déjà exactement la bonne information, sans mécanisme de regroupement parallèle.
//
// Le paquet n'a pas de nom propre : c'est le titre de sa page racine. Deux
// sources pour un même intitulé finiraient par diverger.
// SECTION PRÉDÉFINIE du wiki. Une section EST une page racine ; cette table ne
// fait que désigner laquelle, pour les trois genres que l'application connaît.
//
// L'APPARTENANCE NE SE STOCKE PAS. La section d'une page se calcule en remontant
// ses ancêtres jusqu'à rencontrer une racine de section. Une colonne `section`
// portée par chaque page aurait dit la même chose que l'arbre, et les deux
// auraient fini par se contredire : un enfant de « Réunions » marqué
// « implémentation », et plus personne pour trancher. Déplacer une page d'une
// section à l'autre, c'est donc la reparenter - ce que le wiki sait déjà faire,
// cycles compris.
//
// LA SECTION PROPOSE, LE MARQUEUR DISPOSE. Sous Réunions, créer une page ouvre
// un compte rendu daté ; mais une page sans date posée là reste une page
// ordinaire. Le sens continue d'être porté par les marqueurs existants -
// `WikiPage.meetingDate` pour la date, `SpecPackage` pour les versions -, que la
// section ne remplace pas. Il n'existe ainsi aucun état contradictoire à
// réparer, et aucune migration de rattrapage à écrire le jour où l'on range
// autrement.
model WikiSection {
  id         String          @id @default(cuid())
  projectId  String
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind       WikiSectionKind
  // `Cascade` et non `Restrict` : sans quoi la suppression d'un projet, qui
  // efface ses pages et ses sections dans un ordre non garanti, buterait sur sa
  // propre contrainte. La racine est protégée là où l'on peut la défendre
  // vraiment - dans le service de suppression, seul chemin vers `delete`.
  rootPageId String          @unique
  rootPage   WikiPage        @relation(fields: [rootPageId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  // Une seule racine par genre et par projet : « les » Réunions, pas « des ».
  @@unique([projectId, kind])
  @@index([projectId])
}

// CE QU'UNE PAGE DOCUMENTE. Le wiki cesse d'être un tas de documents pour
// devenir un index du système : depuis un module ou un composant, on trouve sa
// documentation ; depuis un ticket, celle de ce sur quoi l'on travaille.
//
// DEUX TABLES plutôt qu'une seule portant `moduleId` ET `componentId` : dans la
// table unique, une ligne aux deux colonnes nulles - ou aux deux remplies -
// serait représentable, et il faudrait une contrainte de contrôle pour l'interdire
// puis du code pour la respecter. Ici l'état invalide n'existe pas.
//
// Clef primaire COMPOSITE : le même lien ne peut être posé deux fois, sans
// index supplémentaire ni identifiant de substitution dont personne ne se sert.
model WikiPageModule {
  pageId   String
  page     WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  moduleId String
  module   Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([pageId, moduleId])
  @@index([moduleId])
}

model WikiPageComponent {
  pageId      String
  page        WikiPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  componentId String
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@id([pageId, componentId])
  @@index([componentId])
}

model SpecPackage {
  id         String        @id @default(cuid())
  projectId  String
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rootPageId String        @unique
  rootPage   WikiPage      @relation(fields: [rootPageId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())
  versions   SpecVersion[]

  @@index([projectId])
}

// Version PUBLIÉE d'un paquet : un instantané figé, numéroté et citable de toutes
// ses pages. Immuable par construction - on ne modifie jamais une version, on en
// publie une nouvelle. C'est ce qui permet à un ticket de se référer à « la
// spécification v2 » sans que le sens de la phrase change le lendemain.
model SpecVersion {
  id            String             @id @default(cuid())
  packageId     String
  package       SpecPackage        @relation(fields: [packageId], references: [id], onDelete: Cascade)
  // Numéro incrémental par paquet (1, 2, 3…), affiché « v3 ».
  number        Int
  // Intitulé libre facultatif (« MVP », « Recette client »), en plus du numéro.
  label         String?
  // Ce qui a changé depuis la version précédente, saisi à la publication.
  note          String?
  publishedById String?
  publishedBy   User?              @relation(fields: [publishedById], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())
  pages         SpecPageSnapshot[]

  @@unique([packageId, number])
  @@index([packageId])
}

// Contenu figé d'une page au sein d'une version publiée.
model SpecPageSnapshot {
  id        String      @id @default(cuid())
  versionId String
  version   SpecVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  // Page d'origine, ou `null` si elle a été supprimée depuis : l'instantané doit
  // survivre à la disparition de sa source, sinon il n'archive rien.
  pageId    String?
  page      WikiPage?   @relation(fields: [pageId], references: [id], onDelete: SetNull)
  title     String
  content   String
  // Chemin lisible dans l'arborescence au moment du figement (« Guide / Champs »).
  // Conservé tel quel : réorganiser le wiki ensuite ne doit pas réécrire le passé.
  path      String
  // Position dans l'ordre de lecture du document au moment du figement.
  order     Int

  @@index([versionId, order])
}

// Cumul de dépense IA (Mistral) par jour UTC - plafond configurable (ex. mode
// démo : AI_DAILY_BUDGET_USD). Coût exprimé en millionièmes de dollar (micro-USD)
// pour éviter l'arithmétique flottante. Une ligne par jour, incrémentée à chaque
// appel réussi (voir src/lib/ai-budget.ts).
model AiUsageDay {
  date       String   @id // "YYYY-MM-DD" (UTC)
  costMicros Int      @default(0)
  callCount  Int      @default(0)
  updatedAt  DateTime @updatedAt
}
