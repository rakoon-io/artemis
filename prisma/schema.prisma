// Artemis - schéma de données (canonique).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  REPORTER
}

enum SprintState {
  PLANNED
  ACTIVE
  COMPLETED
}

enum EmailStatus {
  SENT
  FAILED
  DISABLED
}

// Cycle de validation d'une brique de structure (module, composant) proposée par
// un rapporteur. Un ADMIN crée directement en APPROVED ; un rapporteur soumet en
// PROPOSED. Tant qu'une proposition n'est pas validée, elle n'apparaît NI dans les
// sélecteurs de ticket, NI dans le contexte transmis à l'IA, NI via MCP : la
// validation est ce qui la fait exister pour le reste de l'application.
// Refuser une proposition la supprime : n'étant référencée par aucun ticket, il
// n'y a pas d'orphelin à gérer, et l'on évite un cimetière d'entrées rejetées.
enum ProposalStatus {
  PROPOSED
  APPROVED
}

// Nature d'un composant applicatif (cf. model Component).
//   PAGE    - un écran / une route de l'application ;
//   SHARED  - un composant réutilisable (design system, widget partagé) ;
//   SERVICE - un service technique (API, job, intégration externe).
enum ComponentKind {
  PAGE
  SHARED
  SERVICE
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String?
  passwordHash       String?
  role               Role                @default(REPORTER)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  reported           Ticket[]            @relation("reporter")
  assigned           Ticket[]            @relation("assignee")
  comments           Comment[]
  attachments        Attachment[]
  wikiPages          WikiPage[]
  memberships        ProjectMember[]
  setupToken         PasswordSetupToken?
  proposedModules    Module[]            @relation("moduleProposals")
  proposedComponents Component[]         @relation("componentProposals")
}

// Jeton de premiere connexion / reinitialisation : lien a usage unique et date
// permettant a un utilisateur de definir son mot de passe. Un seul jeton actif
// par utilisateur (regenerer remplace le precedent). Seul le hash est stocke.
model PasswordSetupToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Journal des e-mails : suivi de tous les envois (notifications, invitations,
// reinitialisation). Statut DISABLED = envoi ignore car Mailjet non configure.
model EmailLog {
  id        String      @id @default(cuid())
  to        String
  subject   String
  type      String // "comment" | "assignment" | "invite" | "reset"
  status    EmailStatus
  error     String?
  createdAt DateTime    @default(now())

  @@index([createdAt])
}

model Project {
  id               String           @id @default(cuid())
  key              String           @unique // ex : "RKN"
  name             String
  description      String?
  accentColor      String? // couleur d'accent personnalisée (hex), null = charte par défaut
  ticketSeq        Int              @default(0) // séquence pour générer les clés RKN-<n>
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  columns          Column[]
  tickets          Ticket[]
  sprints          Sprint[]
  labels           Label[]
  ticketTypes      TicketType[]
  ticketPriorities TicketPriority[]
  modules          Module[]
  components       Component[]
  wikiPages        WikiPage[]
  members          ProjectMember[]
}

// Appartenance d'un utilisateur à un projet : contrôle l'accès.
// Les administrateurs accèdent à tous les projets sans ligne ici ; cette table
// n'accorde l'accès qu'aux Rapporteurs projet par projet.
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}

model Column {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  order     Int
  wipLimit  Int?
  tickets   Ticket[]

  @@index([projectId])
}

// Type de ticket - configurable par projet.
model TicketType {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  color     String // hex, ex : "#6366F1"
  order     Int
  tickets   Ticket[]

  @@unique([projectId, name])
  @@index([projectId])
}

// Priorité de ticket - configurable par projet.
model TicketPriority {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  color     String // hex
  order     Int
  tickets   Ticket[]

  @@unique([projectId, name])
  @@index([projectId])
}

// Module fonctionnel d'un projet : un ensemble de fonctionnalités à grosse
// maille (ex. « Gestion des utilisateurs »), au-dessus des composants. C'est de
// la STRUCTURE PRODUIT, pas un conteneur de travail : un module ne se « termine »
// pas, contrairement à un sprint ou un lot. Il regroupe plusieurs composants
// (écrans, briques partagées, services) et sert à situer une demande à maille
// large. Entièrement facultatif : un projet peut n'en déclarer aucun.
model Module {
  id           String         @id @default(cuid())
  projectId    String
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  description  String? // contexte libre (périmètre fonctionnel du module)
  color        String // hex, ex : "#0EA5E9"
  order        Int
  // Validation : APPROVED par défaut (création par un admin, et données existantes).
  status       ProposalStatus @default(APPROVED)
  // Auteur de la proposition, pour que l'admin sache qui la demande. `SetNull` :
  // la suppression d'un compte ne doit pas emporter la brique de structure.
  proposedById String?
  proposedBy   User?          @relation("moduleProposals", fields: [proposedById], references: [id], onDelete: SetNull)
  components   Component[]
  tickets      Ticket[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
  @@index([projectId, status])
}

// Composant applicatif d'un projet : la brique fonctionnelle CONCERNÉE par une
// demande (« de quoi parle ce ticket ? »). Configurable par projet, comme les
// types et priorités, avec en plus une NATURE (`kind`) : page, composant
// réutilisable ou service. La `description` porte le contexte métier/technique
// du composant : elle est affichée dans l'UI et injectée dans le contexte
// transmis à l'IA lors de la génération de tickets.
model Component {
  id           String         @id @default(cuid())
  projectId    String
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Module de rattachement (facultatif). Les composants transverses - typiquement
  // les `SHARED`, qui servent plusieurs modules - n'en ont volontairement aucun.
  moduleId     String?
  module       Module?        @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  name         String
  kind         ComponentKind  @default(PAGE)
  description  String? // contexte libre (rôle, périmètre, contraintes)
  color        String // hex, ex : "#8B5CF6"
  order        Int
  // Validation : voir `ProposalStatus`. Même logique que pour un module.
  status       ProposalStatus @default(APPROVED)
  proposedById String?
  proposedBy   User?          @relation("componentProposals", fields: [proposedById], references: [id], onDelete: SetNull)
  tickets      Ticket[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
  @@index([moduleId])
  @@index([projectId, status])
}

model Ticket {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number      Int // numéro séquentiel par projet
  key         String // "RKN-123" (dénormalisé pour affichage / recherche)
  title       String
  description String?
  typeId      String
  type        TicketType      @relation(fields: [typeId], references: [id])
  priorityId  String
  priority    TicketPriority  @relation(fields: [priorityId], references: [id])
  // Composant concerné (facultatif) : contextualise la demande. `SetNull` pour
  // qu'un composant supprimé n'entraîne jamais la perte d'un ticket.
  componentId String?
  component   Component?      @relation(fields: [componentId], references: [id], onDelete: SetNull)
  // Module PROPRE du ticket, renseignable uniquement lorsqu'aucun composant n'est
  // choisi (demande à grosse maille). INVARIANT imposé par le service : dès qu'un
  // composant est posé, ce champ repasse à `null` et le module effectif du ticket
  // devient celui du composant. Une seule source de vérité, donc jamais de
  // contradiction entre le module du ticket et celui de son composant.
  moduleId    String?
  module      Module?         @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  columnId    String
  column      Column          @relation(fields: [columnId], references: [id])
  rank        String // ordre dans la colonne (lexorank)
  reporterId  String
  reporter    User            @relation("reporter", fields: [reporterId], references: [id])
  assigneeId  String?
  assignee    User?           @relation("assignee", fields: [assigneeId], references: [id])
  sprintId    String?
  sprint      Sprint?         @relation(fields: [sprintId], references: [id])
  labels      LabelOnTicket[]
  attachments Attachment[]
  comments    Comment[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([projectId, number])
  @@index([projectId, columnId])
  @@index([sprintId])
  @@index([typeId])
  @@index([priorityId])
  @@index([componentId])
  @@index([moduleId])
}

model Sprint {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  goal      String?
  state     SprintState @default(PLANNED)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime    @default(now())
  tickets   Ticket[]

  @@index([projectId])
}

model Label {
  id        String          @id @default(cuid())
  projectId String
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  color     String // hex, ex : "#7C3AED"
  tickets   LabelOnTicket[]

  @@unique([projectId, name])
}

model LabelOnTicket {
  ticketId String
  labelId  String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  label    Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([ticketId, labelId])
}

model Attachment {
  id           String   @id @default(cuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  filename     String
  contentType  String
  size         Int
  storageKey   String
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([ticketId])
}

model Comment {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([ticketId])
}

// Page de wiki d'un projet - documentation libre, avec citations de tickets (RKN-123).
// Organisation arborescente : une page peut avoir une page parente (self-relation).
model WikiPage {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    WikiPage?  @relation("WikiTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  WikiPage[] @relation("WikiTree")
  title     String
  content   String     @default("")
  authorId  String?
  author    User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([projectId])
  @@index([parentId])
}

// Cumul de dépense IA (Mistral) par jour UTC - plafond configurable (ex. mode
// démo : AI_DAILY_BUDGET_USD). Coût exprimé en millionièmes de dollar (micro-USD)
// pour éviter l'arithmétique flottante. Une ligne par jour, incrémentée à chaque
// appel réussi (voir src/lib/ai-budget.ts).
model AiUsageDay {
  date       String   @id // "YYYY-MM-DD" (UTC)
  costMicros Int      @default(0)
  callCount  Int      @default(0)
  updatedAt  DateTime @updatedAt
}
